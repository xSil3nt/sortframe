{
  "name": "sortframe",
  "version": "0.2.3",
  "main": "dist/desktop/main.js",
  "author": "xSil3nt",
  "private": true,
  "description": "Plan Warframe Prime crafting reserves, platinum listings, and ducat conversions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -b && vite build && node scripts/build.mjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "typecheck": "tsc -b --pretty false",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test": "tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
